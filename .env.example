# 이 파일을 .env 로 복사해서 사용.
#   cp .env.example .env
# .env 는 깃에 올리지 않는다.


# PX4 Version 
PX4_IMAGE=px4io/px4-sitl-gazebo:v1.18.0-beta2


# gz_x500_depth = 구매한 X500 기체 + 깊이 카메라(RealSense D435i에 해당)
# 깊이 카메라 없이 비교해 보려면 gz_x500
PX4_SIM_MODEL=gz_x500_depth

# 드론을 띄울 공간. sim/worlds/ 안의 파일 이름을 적는다.
# Gazebo 가 기본 제공하는 공간(default, baylands, walls 등)도 그대로 고를 수 있다.
PX4_GZ_WORLD=kiosk

# 드론이 처음 놓이는 위치 "x,y,z,roll,pitch,yaw" (미터 / 라디안)
DRONE_SPAWN_POSE=0,0,0.2,0,0,0


# --- 포트 --------------------------------------------------------------------
VIEWER_PORT=8080              # 카메라 영상을 보는 브라우저 주소
MAVLINK_GCS_PORT=14550        # QGroundControl 이 접속하는 포트
MAVLINK_OFFBOARD_PORT=14540   # 파이썬 코드가 드론에 명령을 보낼 때 쓰는 포트
XRCE_PORT=8888                # 드론 상태 데이터가 나가는 포트


# --- 화면 (Gazebo 창을 띄울 때만) -----------------------------------------------
DISPLAY=:0
